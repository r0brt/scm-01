{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scm.local/schemas/analysis.schema.json",
  "title": "SCM Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symptome",
    "ursachen",
    "emotionen",
    "narrative",
    "mythen",
    "essenz"
  ],
  "properties": {
    "symptome": { "$ref": "#/$defs/ebene" },
    "ursachen": { "$ref": "#/$defs/ebene" },
    "emotionen": { "$ref": "#/$defs/ebene" },
    "narrative": { "$ref": "#/$defs/ebene" },
    "mythen": { "$ref": "#/$defs/ebene" },
    "essenz": { "$ref": "#/$defs/ebene" }
  },
  "$defs": {
    "ebene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beschreibung", "eintraege"],
      "properties": {
        "beschreibung": {
          "type": "string",
          "minLength": 1
        },
        "eintraege": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/eintrag"
          }
        }
      }
    },
    "eintrag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
