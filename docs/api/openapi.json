        "title": "AnalysisRunResponse",
        "type": "object"
      },
      "ErrorPayload": {
        "description": "Public API error payload.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
