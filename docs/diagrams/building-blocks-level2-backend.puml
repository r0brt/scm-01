@startuml
top to bottom direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam linetype ortho

cloud "OpenAI Provider API\n(optional external dependency)" as openai
database "Lokale Persistenz" as persistence

package "Backend API" {
  component "API Layer\n(app/api)" as api_layer
  component "Analysis Workflow\n(app/services/analysis_workflow.py)" as workflow
  component "Language Detection\n(app/language)" as language
  component "Validation Service\n(app/services/validation.py)" as validation
  component "LLM Adapter\n(app/llm)" as llm
  component "Run Repository\n(app/repositories)" as repo
  component "DB Model + Session\n(app/db)" as db
}

api_layer --> workflow : Analyse starten,\nRun laden, Rerun
workflow --> language : Eingabe- und\nAusgabesprache prüfen
workflow --> llm : Analyse generieren
workflow --> validation : Payload validieren
workflow --> repo : Run persistieren/laden
repo --> db : Session + Modellzugriff
db --> persistence : relationale Speicherung
llm --> openai : optionaler Provider-Aufruf

@enduml
