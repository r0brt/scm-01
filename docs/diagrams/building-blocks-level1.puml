@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

actor "User" as user
cloud "OpenAI Provider API\n(optional external dependency)" as openai

rectangle "SCM" {
  rectangle "Frontend UI" as frontend
  rectangle "Backend API" as api
  database "Lokale Persistenz" as persistence
}

user --> frontend : Texteingabe,\nRun-Historie,\nErgebnisansicht
frontend --> api : HTTP/JSON\n/api/v1/analyses
api --> persistence : Runs und Metadaten\npersistieren/laden
api --> openai : Analyseerzeugung über Adapter\n(optional bei Provider=openai)

@enduml
