@startuml
title UJ1 Fehlerpfade: failed Runs und Providerfehler

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "User" as user
participant "Web UI" as frontend
participant "Backend/API" as api
participant "Language Detection" as detector
participant "LLM Adapter" as adapter
participant "Validation Service" as validation
database "Run Repository / Persistence" as persistence

user -> frontend : Problemtext erfassen\nund Analyse starten
frontend -> api : POST /api/v1/analyses { text }
api -> api : correlation_id erzeugen
api -> detector : Eingabesprache lokal erkennen

alt Sprache zu unsicher oder nicht unterstützt
  detector --> api : LANGUAGE_CONFIDENCE_TOO_LOW\noder UNSUPPORTED_LANGUAGE
  api -> persistence : failed Run mit Sprachmetadaten,\nerror_code und correlation_id speichern
  persistence --> api : gespeicherter Run
  api --> frontend : 201 Created mit failed Run
else Sprache gültig
  detector --> api : detected_language,\nlanguage_confidence
  api -> adapter : generate_analysis(text,\nlanguage=detected_language)

  alt Adapter-/Providerfehler vor verwertbarem Payload
    adapter --> api : kein verwertbares Payload
    api --> frontend : 502 Bad Gateway\nANALYSIS_PROVIDER_ERROR + correlation_id
    note right of api
      Kein persistierter Analyse-Run,
      weil kein validierbarer Payload vorliegt.
    end note
  else Payload erhalten
    adapter --> api : Analyse-Payload,\nmodel_id, prompt_version
    api -> validation : JSON Schema + Pydantic prüfen
    validation --> api : validiertes Payload\noder Fehlerreport

    alt Struktur ungültig
      api -> persistence : failed Run mit validation_report\nund error_code speichern
      persistence --> api : gespeicherter Run
      api --> frontend : 201 Created mit failed Run
    else Struktur gültig, Ausgabesprache falsch
      api -> detector : Ausgabesprache lokal prüfen
      detector --> api : OUTPUT_LANGUAGE_MISMATCH
      api -> persistence : failed Run mit OUTPUT_LANGUAGE_MISMATCH speichern
      persistence --> api : gespeicherter Run
      api --> frontend : 201 Created mit failed Run
    end
  end
end

note over validation
  Bounded Repair ist als Guardrail vorbereitet,
  aber nicht Teil des aktiven Standardpfads.
end note

frontend --> user : Fehlerzustand mit Run-Nachweis\noder globalem API-Fehler anzeigen

@enduml
